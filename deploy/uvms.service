[Unit]
Description=UVMS Rust H264 audio and surveillance service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uvms
Group=uvms
WorkingDirectory=/opt/uvms
Environment=UVMS_CONFIG=/etc/uvms/config.toml
EnvironmentFile=/etc/uvms/uvms.env
ExecStart=/opt/uvms/uvms-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=40
KillMode=control-group
StateDirectory=uvms
ReadWritePaths=/var/lib/uvms
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/usr/bin/ffmpeg -/usr/bin/ffprobe
RestrictSUIDSGID=true
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
